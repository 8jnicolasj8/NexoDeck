    {
      "kind": "volume.master",
      "category": "audio",
      "labelKey": "action.volumeMaster",
      "icon": "volume-2",
      "params": [],
      "slider": { "min": 0, "max": 100, "step": 1, "stateBinding": "audio.masterVolume" }
    },
    {
      "kind": "volume.app",
      "category": "audio",
      "labelKey": "action.volumeApp",
      "icon": "volume-1",
      "params": [
        {
          "name": "process",
          "type": "process-picker",
          "labelKey": "param.process",
          "required": true
        }
      ],
      "slider": { "min": 0, "max": 100, "step": 1 }
    },
    {
      "kind": "mute.toggle",
      "category": "audio",
      "labelKey": "action.muteToggle",
      "icon": "volume-x",
      "params": [
        {
          "name": "target",
          "type": "select",
          "labelKey": "param.muteTarget",
          "required": true,
          "default": "master",
          "options": [
            { "value": "master", "labelKey": "option.mute.master" },
            { "value": "mic", "labelKey": "option.mute.mic" },
            { "value": "app", "labelKey": "option.mute.app" }
          ]
        },
        {
          "name": "process",
          "type": "process-picker",
          "labelKey": "param.process",
          "required": true,
          "showIf": { "param": "target", "equals": "app" }
        }
      ],
      "stateBinding": { "param": "target", "map": { "master": "audio.muted", "mic": "mic.muted" } }
    },
    {
      "kind": "audio.device",
      "category": "audio",
      "labelKey": "action.audioDevice",
      "icon": "headphones",
      "params": [
        {
          "name": "flow",
          "type": "select",
          "labelKey": "param.audioFlow",
          "required": true,
          "default": "output",
          "options": [
            { "value": "output", "labelKey": "option.flow.output" },
            { "value": "input", "labelKey": "option.flow.input" }
          ]
        },
        {
          "name": "mode",
          "type": "select",
          "labelKey": "param.audioMode",
          "required": true,
          "default": "cycle",
          "options": [
            { "value": "cycle", "labelKey": "option.audioMode.cycle" },
            { "value": "specific", "labelKey": "option.audioMode.specific" }
          ]
        },
        {
          "name": "deviceId",
          "type": "audio-device-picker",
          "labelKey": "param.audioDevice",
          "required": true,
          "showIf": { "param": "mode", "equals": "specific" }
        },
        {
          "name": "devices",
          "type": "audio-device-multi",
          "labelKey": "param.audioDevicePool",
          "showIf": { "param": "mode", "equals": "cycle" },
          "helpKey": "help.audioDevicePool"
        }
      ]
    },
