        { "group": "windows", "labelKey": "preset.windows.desktop", "keys": ["win", "d"] },
        { "group": "windows", "labelKey": "preset.windows.screenshot", "keys": ["win", "shift", "s"] },
        { "group": "windows", "labelKey": "preset.windows.taskManager", "keys": ["ctrl", "shift", "esc"] },
        { "group": "windows", "labelKey": "preset.windows.explorer", "keys": ["win", "e"] },
