          "name": "cmd",
          "type": "select",
          "labelKey": "param.mediaCmd",
          "required": true,
          "default": "playpause",
          "options": [
            { "value": "playpause", "labelKey": "option.media.playpause" },
            { "value": "next", "labelKey": "option.media.next" },
            { "value": "prev", "labelKey": "option.media.prev" },
            { "value": "stop", "labelKey": "option.media.stop" },
            { "value": "volup", "labelKey": "option.media.volup" },
            { "value": "voldown", "labelKey": "option.media.voldown" },
            { "value": "mute", "labelKey": "option.media.mute" }
          ]
