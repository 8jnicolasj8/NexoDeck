      "presets": [
        { "group": "browser", "labelKey": "preset.browser.newTab", "keys": ["ctrl", "t"] },
        { "group": "browser", "labelKey": "preset.browser.closeTab", "keys": ["ctrl", "w"] },
        { "group": "browser", "labelKey": "preset.browser.reopenTab", "keys": ["ctrl", "shift", "t"] },
        { "group": "browser", "labelKey": "preset.browser.nextTab", "keys": ["ctrl", "pagedown"] },
        { "group": "browser", "labelKey": "preset.browser.prevTab", "keys": ["ctrl", "pageup"] },
        { "group": "browser", "labelKey": "preset.browser.reload", "keys": ["f5"] },
