---
import Layout from '../layouts/Layout.astro';
import { copy } from '../i18n';
import { brand } from '../lib/brand';

const t = copy.es.thanks;
---

<Layout lang="es" path="/gracias/" altPath="/en/thanks/" title={`${t.title} — ${brand.name}`} noindex>
  <article class="mx-auto max-w-2xl px-5 py-20">
    <p class="font-mono text-xs uppercase tracking-[0.2em] text-accent">descarga iniciada</p>
    <h1 class="mt-4 text-3xl font-semibold tracking-tight">{t.title}</h1>
    <p class="mt-3 text-muted">{t.lead}</p>
    <ol class="mt-8 space-y-3">
      {t.steps.map((step, index) => (
        <li class="card flex gap-4 p-4 text-sm text-muted">
          <span class="font-mono text-xs text-accent">{String(index + 1).padStart(2, '0')}</span>
          {step}
        </li>
      ))}
    </ol>
    <a href="/" class="mt-8 inline-flex rounded-lg border border-line px-4 py-2.5 text-sm font-semibold hover:border-muted/60">← {t.back}</a>
  </article>
</Layout>
