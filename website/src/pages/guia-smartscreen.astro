---
import GuideLayout from '../components/GuideLayout.astro';
import { copy } from '../i18n';

const g = copy.es.guides.smartscreen;
---

<GuideLayout
  lang="es"
  path="/guia-smartscreen/"
  altPath="/en/smartscreen/"
  title={g.title}
  lead={g.lead}
  steps={g.steps}
  back={g.back}
  hashTitle={g.hashTitle}
  hashBody={g.hashBody}
/>
