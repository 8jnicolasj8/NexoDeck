---
import { brand } from '../lib/brand';
import { copy, type Lang } from '../i18n';

const { lang } = Astro.props as { lang: Lang };
const t = copy[lang];
const home = lang === 'es' ? '/' : '/en/';
const links = [
  { href: `${home}#como-funciona`, label: t.nav.how },
  { href: `${home}#funciones`, label: t.nav.features },
  { href: `${home}#descargas`, label: t.nav.downloads },
  { href: `${home}#preguntas`, label: t.nav.faq },
];
---

<header class="sticky top-0 z-40 border-b border-line/70 bg-bg/85 backdrop-blur">
  <div class="mx-auto flex h-16 max-w-6xl items-center gap-6 px-5">
    <a href={home} class="flex items-center gap-2.5" aria-label={brand.name}>
      <img src="/logo-mark.png" alt="" width="30" height="30" class="h-[30px] w-[30px]" />
      <span class="text-[17px] font-semibold tracking-tight">{brand.name}</span>
    </a>
    <nav aria-label={lang === 'es' ? 'Principal' : 'Main'} class="hidden items-center gap-7 text-sm text-muted md:flex">
      {links.map((link) => <a class="transition-colors hover:text-ink" href={link.href}>{link.label}</a>)}
    </nav>
    <div class="ml-auto flex items-center gap-2">
      <a
        href={t.nav.otherLangHref}
        hreflang={lang === 'es' ? 'en' : 'es'}
        class="rounded-lg border border-line px-3 py-1.5 text-xs font-medium text-muted transition-colors hover:border-muted/60 hover:text-ink"
      >
        {t.nav.otherLang}
      </a>
      <a
        href={brand.repo}
        class="hidden rounded-lg border border-line px-3 py-1.5 text-xs font-medium text-muted transition-colors hover:border-muted/60 hover:text-ink sm:inline-block"
        rel="noopener"
      >
        {t.nav.repo}
      </a>
      <a
        href={`${home}#descargas`}
        class="rounded-lg bg-accent px-3.5 py-2 text-xs font-semibold text-black transition-opacity hover:opacity-90"
      >
        {t.hero.primary}
      </a>
    </div>
  </div>
</header>
